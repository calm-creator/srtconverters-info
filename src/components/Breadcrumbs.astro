---
interface Crumb {
  name: string;
  path: string;
}

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
---

<nav class="breadcrumbs-nav" aria-label="Breadcrumb">
  <ol class="breadcrumbs-list">
    {crumbs.map((crumb, index) => {
      const isLast = index === crumbs.length - 1;
      return (
        <li class="breadcrumb-item">
          {index > 0 && (
            <span class="breadcrumb-separator" aria-hidden="true">
              <svg class="icon-flip-rtl" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6" />
              </svg>
            </span>
          )}
          {isLast ? (
            <span class="breadcrumb-current" aria-current="page">
              {crumb.name}
            </span>
          ) : (
            <a href={crumb.path} class="breadcrumb-link">
              {crumb.name}
            </a>
          )}
        </li>
      );
    })}
  </ol>
</nav>

<style>
  .breadcrumbs-nav {
    margin-block-end: 1.5rem;
    width: 100%;
  }

  .breadcrumbs-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    list-style: none;
    gap: 0.375rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    padding: 0;
    margin: 0;
  }

  .breadcrumb-item {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--text-muted);
    word-break: break-word;
  }

  .breadcrumb-link {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .breadcrumb-link:hover {
    color: var(--text-primary);
    text-decoration: underline;
  }

  .breadcrumb-separator {
    display: inline-flex;
    align-items: center;
    color: var(--border-strong);
    flex-shrink: 0;
  }

  .breadcrumb-current {
    font-weight: 600;
    color: var(--text-primary);
  }

  @media (max-width: 480px) {
    .breadcrumbs-nav {
      margin-block-end: 1rem;
    }

    .breadcrumbs-list {
      font-size: 0.75rem;
      gap: 0.25rem;
    }
  }
</style>
