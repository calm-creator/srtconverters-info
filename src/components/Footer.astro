---
import type { Locale } from '../i18n/locales';
import { getHomePath, getToolPath, getPagePath } from '../i18n/routes';
import { getUi } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = getUi(locale);
const currentYear = new Date().getFullYear();

const homeUrl = getHomePath(locale);
const toolUrl = getToolPath('srt-to-txt', locale);
const toolsUrl = getPagePath('tools', locale);
const aboutUrl = getPagePath('about', locale);
const contactUrl = getPagePath('contact', locale);
const privacyUrl = getPagePath('privacy', locale);
const termsUrl = getPagePath('terms', locale);
---

<footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-grid">
      <!-- Brand column -->
      <div class="footer-col footer-col-brand">
        <a href={homeUrl} class="footer-brand" aria-label={ui.siteName}>
          <span class="brand-logo" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 32 32" fill="none">
              <rect width="32" height="32" rx="6" fill="currentColor"/>
              <rect x="5" y="8" width="22" height="16" rx="3" stroke="var(--bg-app)" stroke-width="2"/>
              <line x1="9" y1="18" x2="16" y2="18" stroke="var(--bg-app)" stroke-width="2" stroke-linecap="round"/>
              <line x1="19" y1="18" x2="23" y2="18" stroke="var(--bg-app)" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </span>
          <span class="brand-name">{ui.siteName}</span>
        </a>
        <p class="footer-desc">{ui.footer.aboutText}</p>
        <p class="footer-notice">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
          <span>{ui.footer.clientSideNotice}</span>
        </p>
      </div>

      <!-- Tools column -->
      <div class="footer-col">
        <p class="footer-heading">{ui.footer.toolsHeading}</p>
        <ul class="footer-links">
          <li>
            <a href={toolUrl} class="footer-link">SRT to TXT</a>
          </li>
          <li>
            <a href={getToolPath('txt-to-srt', locale)} class="footer-link">TXT to SRT</a>
          </li>
          <li>
            <a href={toolsUrl} class="footer-link">{ui.nav.tools}</a>
          </li>
        </ul>
      </div>

      <!-- Legal column -->
      <div class="footer-col">
        <p class="footer-heading">{ui.footer.legalHeading}</p>
        <ul class="footer-links">
          <li>
            <a href={privacyUrl} class="footer-link">{ui.footer.privacyPolicy}</a>
          </li>
          <li>
            <a href={termsUrl} class="footer-link">{ui.footer.termsOfService}</a>
          </li>
        </ul>
      </div>

      <!-- About & Support column -->
      <div class="footer-col">
        <p class="footer-heading">{ui.footer.aboutHeading}</p>
        <ul class="footer-links">
          <li>
            <a href={aboutUrl} class="footer-link">{ui.nav.about}</a>
          </li>
          <li>
            <a href={contactUrl} class="footer-link">{ui.footer.contact}</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copy">
        &copy; {currentYear} {ui.siteName}. {ui.footer.allRightsReserved}
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border-subtle);
    background-color: var(--bg-surface);
    padding-block: 3.5rem 2rem;
    margin-top: auto;
  }

  /* Desktop Multi-column Grid (>= 768px) */
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 2.5rem;
    margin-block-end: 2.5rem;
  }

  .footer-col-brand {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    text-align: start;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--text-primary);
  }

  .brand-logo {
    display: flex;
    color: var(--text-primary);
  }

  .brand-name {
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: -0.01em;
  }

  .footer-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .footer-notice {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    text-align: start;
  }

  .footer-heading {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-primary);
    margin-block-end: 1rem;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 0;
    margin: 0;
  }

  .footer-link {
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s ease;
    padding-block: 0.125rem;
  }

  .footer-link:hover {
    color: var(--text-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-bottom {
    border-top: 1px solid var(--border-subtle);
    padding-top: 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  /* ==========================================================================
     MOBILE FOOTER: STRICTLY CENTER-ALIGNED (< 768px)
     ========================================================================== */
  @media (max-width: 767px) {
    .site-footer {
      padding-block: 2.75rem 1.75rem;
    }

    .footer-grid {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 2rem;
      margin-block-end: 2rem;
    }

    .footer-col {
      align-items: center;
      text-align: center;
      width: 100%;
    }

    .footer-col-brand {
      align-items: center;
      text-align: center;
      max-width: 480px;
      margin-inline: auto;
    }

    .footer-brand {
      justify-content: center;
    }

    .footer-desc {
      text-align: center;
    }

    .footer-notice {
      justify-content: center;
      text-align: center;
    }

    .footer-heading {
      text-align: center;
      margin-block-end: 0.75rem;
    }

    .footer-links {
      align-items: center;
      text-align: center;
      gap: 0.75rem;
    }

    .footer-link {
      display: inline-block;
      text-align: center;
      padding-block: 0.25rem;
    }

    .footer-bottom {
      justify-content: center;
      text-align: center;
    }

    .footer-copy {
      text-align: center;
      width: 100%;
    }
  }
</style>
