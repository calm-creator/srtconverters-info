---
import type { Locale } from '../i18n/locales';
import { getHomePath, getToolPath, getPagePath } from '../i18n/routes';
import { getUi } from '../i18n/ui';
import LanguageSelector from './LanguageSelector.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
  pageType: 'home' | 'tool' | 'page';
  pageId: string;
}

const { locale, pageType, pageId } = Astro.props;
const ui = getUi(locale);
const homeUrl = getHomePath(locale);
const toolsUrl = getPagePath('tools', locale);
const aboutUrl = getPagePath('about', locale);
const contactUrl = getPagePath('contact', locale);
const privacyUrl = getPagePath('privacy', locale);
const termsUrl = getPagePath('terms', locale);
---

<header class="site-header">
  <div class="container header-container">
    <!-- Left: Brand Logo & Name -->
    <div class="brand-group">
      <a href={homeUrl} class="brand-link" aria-label={ui.siteName}>
        <span class="brand-logo" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 32 32" fill="none">
            <rect width="32" height="32" rx="6" fill="currentColor"/>
            <rect x="5" y="8" width="22" height="16" rx="3" stroke="var(--bg-app)" stroke-width="2"/>
            <line x1="9" y1="18" x2="16" y2="18" stroke="var(--bg-app)" stroke-width="2" stroke-linecap="round"/>
            <line x1="19" y1="18" x2="23" y2="18" stroke="var(--bg-app)" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </span>
        <span class="brand-name">{ui.siteName}</span>
      </a>
    </div>

    <!-- Right Controls: Desktop Nav + Shared Actions + Mobile Hamburger -->
    <div class="header-right">
      <!-- Desktop Navigation Link (hidden on mobile) -->
      <nav class="desktop-nav" aria-label="Desktop Navigation">
        <a href={toolsUrl} class="desktop-nav-link">
          {ui.nav.tools}
        </a>
      </nav>

      <!-- Language Selector (visible ONLY on multilingual pages, hidden on English-only legal/trust pages) -->
      {!['privacy', 'terms', 'about', 'contact'].includes(pageId) && (
        <LanguageSelector
          currentLocale={locale}
          pageType={pageType}
          pageId={pageId}
          label={ui.nav.language}
        />
      )}

      <!-- Theme Toggle (ALWAYS visible on desktop & mobile) -->
      <ThemeToggle label={ui.nav.themeToggle} />

      <!-- Mobile Hamburger Button (visible ONLY on mobile < 768px) -->
      <button
        type="button"
        class="hamburger-btn"
        id="hamburger-btn"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <span class="hamburger-box" aria-hidden="true">
          <span class="hamburger-line line-top"></span>
          <span class="hamburger-line line-middle"></span>
          <span class="hamburger-line line-bottom"></span>
        </span>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer Overlay & Panel -->
  <div class="mobile-drawer-backdrop" id="drawer-backdrop" aria-hidden="true"></div>

  <nav
    class="mobile-drawer"
    id="mobile-drawer"
    aria-label="Mobile Navigation"
    aria-hidden="true"
  >
    <div class="mobile-drawer-header">
      <span class="mobile-drawer-title">{ui.nav.tools}</span>
      <button
        type="button"
        class="drawer-close-btn"
        id="drawer-close-btn"
        aria-label="Close menu"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>

    <div class="mobile-drawer-content">
      <ul class="mobile-nav-list">
        <li class="mobile-nav-item">
          <a href={toolsUrl} class="mobile-nav-link">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
              <polyline points="14 2 14 8 20 8"/>
            </svg>
            <span>{ui.nav.tools}</span>
          </a>
        </li>
        <li class="mobile-nav-item">
          <a href={aboutUrl} class="mobile-nav-link">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10" />
              <line x1="12" y1="16" x2="12" y2="12" />
              <line x1="12" y1="8" x2="12.01" y2="8" />
            </svg>
            <span>{ui.nav.about}</span>
          </a>
        </li>
        <li class="mobile-nav-item">
          <a href={contactUrl} class="mobile-nav-link">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="20" height="16" x="2" y="4" rx="2" />
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
            </svg>
            <span>{ui.nav.contact}</span>
          </a>
        </li>
        <li class="mobile-nav-item">
          <a href={privacyUrl} class="mobile-nav-link">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
            <span>{ui.nav.privacy}</span>
          </a>
        </li>
        <li class="mobile-nav-item">
          <a href={termsUrl} class="mobile-nav-link">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
              <line x1="16" y1="13" x2="8" y2="13"/>
              <line x1="16" y1="17" x2="8" y2="17"/>
              <polyline points="10 9 9 9 8 9"/>
            </svg>
            <span>{ui.nav.terms}</span>
          </a>
        </li>
      </ul>
    </div>
  </nav>
</header>

<style>
  .site-header {
    height: var(--header-height);
    border-bottom: 1px solid var(--border-subtle);
    background-color: var(--bg-app);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-container {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .brand-group {
    display: flex;
    align-items: center;
    flex-shrink: 1;
    min-width: 0;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--text-primary);
  }

  .brand-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-primary);
    flex-shrink: 0;
  }

  .brand-name {
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex-shrink: 0;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    margin-inline-end: 0.5rem;
  }

  .desktop-nav-link {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
    padding: 0.375rem 0.625rem;
  }

  .desktop-nav-link:hover {
    color: var(--text-primary);
    opacity: 1;
  }

  /* Hamburger Button (Mobile Only) */
  .hamburger-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-default);
    background-color: var(--bg-surface);
    color: var(--text-primary);
    transition: background-color 0.15s ease, border-color 0.15s ease;
    flex-shrink: 0;
  }

  .hamburger-btn:hover {
    background-color: var(--bg-surface-hover);
    border-color: var(--border-strong);
  }

  .hamburger-box {
    width: 18px;
    height: 14px;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .hamburger-line {
    display: block;
    width: 100%;
    height: 2px;
    background-color: var(--text-primary);
    border-radius: 1px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  /* Animated Hamburger to X */
  .hamburger-btn[aria-expanded="true"] .line-top {
    transform: translateY(6px) rotate(45deg);
  }
  .hamburger-btn[aria-expanded="true"] .line-middle {
    opacity: 0;
  }
  .hamburger-btn[aria-expanded="true"] .line-bottom {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* Mobile Drawer Backdrop */
  .mobile-drawer-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background-color: var(--bg-overlay);
    backdrop-filter: blur(2px);
    z-index: 998;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .mobile-drawer-backdrop.is-active {
    display: block;
    opacity: 1;
  }

  /* Mobile Drawer Panel */
  .mobile-drawer {
    display: none;
    position: fixed;
    top: 0;
    bottom: 0;
    inset-inline-end: 0;
    width: min(85vw, 320px);
    background-color: var(--bg-surface-elevated);
    border-inline-start: 1px solid var(--border-default);
    z-index: 999;
    box-shadow: -4px 0 24px rgba(0, 0, 0, 0.15);
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  html[dir="rtl"] .mobile-drawer {
    transform: translateX(-100%);
    box-shadow: 4px 0 24px rgba(0, 0, 0, 0.15);
  }

  .mobile-drawer.is-open {
    display: flex;
    transform: translateX(0);
  }

  html[dir="rtl"] .mobile-drawer.is-open {
    transform: translateX(0);
  }

  .mobile-drawer-header {
    height: var(--header-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: 1.25rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .mobile-drawer-title {
    font-size: 0.9375rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-primary);
  }

  .drawer-close-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-default);
    background-color: var(--bg-surface);
    color: var(--text-primary);
  }

  .drawer-close-btn:hover {
    background-color: var(--bg-surface-hover);
  }

  .mobile-drawer-content {
    flex: 1;
    overflow-y: auto;
    padding: 1.25rem;
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
  }

  .mobile-nav-item {
    width: 100%;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .mobile-nav-link:hover {
    background-color: var(--bg-surface-hover);
    border-color: var(--border-default);
    opacity: 1;
  }

  /* Mobile Responsive Breakpoints */
  @media (max-width: 767px) {
    .desktop-nav {
      display: none;
    }

    .hamburger-btn {
      display: inline-flex;
    }

    .mobile-drawer {
      display: flex;
    }
  }

  @media (max-width: 480px) {
    .header-container {
      padding-inline: 0.75rem;
      gap: 0.5rem;
    }

    .header-right {
      gap: 0.375rem;
    }

    .brand-name {
      font-size: 0.875rem;
    }

    .brand-logo svg {
      width: 20px;
      height: 20px;
    }

    .hamburger-btn {
      width: 36px;
      height: 36px;
    }
  }

  @media (max-width: 340px) {
    .brand-name {
      font-size: 0.8125rem;
    }
    .header-right {
      gap: 0.25rem;
    }
  }
</style>

<script is:inline>
  (function () {
    const hamburgerBtn = document.getElementById('hamburger-btn');
    const closeBtn = document.getElementById('drawer-close-btn');
    const drawer = document.getElementById('mobile-drawer');
    const backdrop = document.getElementById('drawer-backdrop');
    if (!hamburgerBtn || !drawer || !backdrop) return;

    function openMenu() {
      // If mobile language dialog is open, close it first
      const langCloseBtn = document.getElementById('mobile-lang-close-btn');
      const langDialog = document.getElementById('mobile-lang-dialog');
      if (langDialog && langDialog.classList.contains('is-open') && langCloseBtn) {
        langCloseBtn.click();
      }

      hamburgerBtn.setAttribute('aria-expanded', 'true');
      hamburgerBtn.setAttribute('aria-label', 'Close menu');
      drawer.classList.add('is-open');
      drawer.setAttribute('aria-hidden', 'false');
      backdrop.classList.add('is-active');
      backdrop.setAttribute('aria-hidden', 'false');
      document.body.classList.add('menu-open');
      if (closeBtn) closeBtn.focus();
    }

    function closeMenu() {
      hamburgerBtn.setAttribute('aria-expanded', 'false');
      hamburgerBtn.setAttribute('aria-label', 'Open menu');
      drawer.classList.remove('is-open');
      drawer.setAttribute('aria-hidden', 'true');
      backdrop.classList.remove('is-active');
      backdrop.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('menu-open');
      hamburgerBtn.focus();
    }

    function toggleMenu() {
      const isOpen = hamburgerBtn.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    }

    hamburgerBtn.addEventListener('click', toggleMenu);
    if (closeBtn) closeBtn.addEventListener('click', closeMenu);
    backdrop.addEventListener('click', closeMenu);

    // Close on navigation link click
    const drawerLinks = drawer.querySelectorAll('a');
    drawerLinks.forEach(function (link) {
      link.addEventListener('click', closeMenu);
    });

    // Close on Escape key
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && hamburgerBtn.getAttribute('aria-expanded') === 'true') {
        closeMenu();
      }
    });

    // Close on resize to desktop
    window.addEventListener('resize', function () {
      if (window.innerWidth >= 768 && hamburgerBtn.getAttribute('aria-expanded') === 'true') {
        closeMenu();
      }
    });
  })();
</script>
