---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<button
  type="button"
  class="theme-toggle"
  id="theme-toggle-btn"
  aria-label={label}
  title={label}
>
  <!-- Moon icon (shows in light mode to switch to dark) -->
  <svg class="icon-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
  </svg>
  <!-- Sun icon (shows in dark mode to switch to light) -->
  <svg class="icon-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2" />
    <path d="M12 20v2" />
    <path d="m4.93 4.93 1.41 1.41" />
    <path d="m17.66 17.66 1.41 1.41" />
    <path d="M2 12h2" />
    <path d="M20 12h2" />
    <path d="m6.34 17.66-1.41 1.41" />
    <path d="m19.07 4.93-1.41 1.41" />
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-default);
    background-color: var(--bg-surface);
    color: var(--text-primary);
    transition: background-color 0.15s ease, border-color 0.15s ease;
    flex-shrink: 0;
  }

  .theme-toggle:hover {
    background-color: var(--bg-surface-hover);
    border-color: var(--border-strong);
  }

  @media (max-width: 640px) {
    .theme-toggle {
      width: 36px;
      height: 36px;
    }
  }

  /* Icons visibility based on theme */
  :global([data-theme="dark"]) .icon-moon {
    display: none;
  }
  :global([data-theme="dark"]) .icon-sun {
    display: block;
  }

  :global(:not([data-theme="dark"])) .icon-moon {
    display: block;
  }
  :global(:not([data-theme="dark"])) .icon-sun {
    display: none;
  }
</style>

<script is:inline>
  (function () {
    const btn = document.getElementById('theme-toggle-btn');
    if (!btn) return;

    btn.addEventListener('click', function () {
      const currentTheme = document.documentElement.getAttribute('data-theme');
      const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', newTheme);
      try {
        localStorage.setItem('theme', newTheme);
      } catch (e) {}
    });
  })();
</script>
