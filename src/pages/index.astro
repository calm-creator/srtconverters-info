---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEOHead from '../components/SEOHead.astro';
import FAQSection from '../components/FAQSection.astro';
import { DEFAULT_LOCALE } from '../i18n/locales';
import { getHomePath, getToolPath } from '../i18n/routes';
import { HOME_CONTENT } from '../data/homeContent';
import { getAllTools } from '../data/tools';
import { getUi } from '../i18n/ui';

const locale = DEFAULT_LOCALE;
const homeData = HOME_CONTENT.en;
const ui = getUi(locale);
const canonicalPath = getHomePath(locale); // '/'
const tools = getAllTools();
const mainToolUrl = getToolPath('srt-to-txt', locale); // '/srt-to-txt/'
---

<BaseLayout locale={locale} pageType="home" pageId="home">
  <SEOHead
    slot="head"
    title={homeData.metaTitle}
    description={homeData.metaDescription}
    locale={locale}
    canonicalPath={canonicalPath}
    pageType="home"
    pageId="home"
    faqList={homeData.faqs}
  />

  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container hero-container">
      <div class="hero-badge-wrap">
        <span class="badge hero-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
          <span>{homeData.heroBadge}</span>
        </span>
      </div>

      <h1 class="hero-title">{homeData.heroTitle}</h1>
      <p class="hero-subtitle">{homeData.heroSubtitle}</p>

      <div class="hero-cta-group">
        <a href={mainToolUrl} class="btn btn-primary btn-lg hero-cta-btn">
          <span>{homeData.primaryCta}</span>
          <svg class="icon-flip-rtl" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="12 5 19 12 12 19" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Tools Showcase Section -->
  <section class="tools-section" id="tools">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">{homeData.toolsHeading}</h2>
        <p class="section-subtitle">{homeData.toolsSubtitle}</p>
      </div>

      <div class="tools-grid">
        {tools.map((tool) => {
          const toolUrl = getToolPath(tool.id, locale);
          const toolName = tool.name[locale] || tool.name.en;
          const toolDesc = tool.shortDescription[locale] || tool.shortDescription.en;

          return (
            <div class="tool-card">
              <div class="tool-card-icon" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
                  <polyline points="14 2 14 8 20 8"/>
                  <line x1="16" y1="13" x2="8" y2="13"/>
                  <line x1="16" y1="17" x2="8" y2="17"/>
                  <line x1="10" y1="9" x2="8" y2="9"/>
                </svg>
              </div>

              <div class="tool-card-body">
                <h3 class="tool-card-title">{toolName}</h3>
                <p class="tool-card-desc">{toolDesc}</p>
              </div>

              <div class="tool-card-action">
                <a href={toolUrl} class="btn btn-primary tool-link">
                  <span>{homeData.primaryCta}</span>
                  <svg class="icon-flip-rtl" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="5" y1="12" x2="19" y2="12" />
                    <polyline points="12 5 19 12 12 19" />
                  </svg>
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- How It Works Section -->
  <section class="how-it-works-section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">{homeData.howItWorksHeading}</h2>
      </div>

      <div class="steps-grid">
        {homeData.steps.map((item) => (
          <div class="step-card">
            <span class="step-num">{item.step}</span>
            <h3 class="step-title">{item.title}</h3>
            <p class="step-desc">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="features-section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">{homeData.featuresHeading}</h2>
      </div>

      <div class="features-grid">
        {homeData.features.map((feat) => (
          <div class="feature-card">
            <h3 class="feature-title">{feat.title}</h3>
            <p class="feature-desc">{feat.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQs Section -->
  <section class="home-faq-section">
    <div class="container">
      <FAQSection faqs={homeData.faqs} title={homeData.faqHeading} />
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero-section {
    padding-block: 4rem 3.5rem;
    border-bottom: 1px solid var(--border-subtle);
    background-color: var(--bg-surface);
    width: 100%;
    box-sizing: border-box;
  }

  .hero-container {
    text-align: center;
    max-width: 820px;
    box-sizing: border-box;
  }

  .hero-badge-wrap {
    margin-block-end: 1.25rem;
  }

  .hero-badge {
    gap: 0.5rem;
    padding-block: 0.375rem;
    padding-inline: 0.875rem;
  }

  .hero-title {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-block-end: 1.25rem;
    word-break: break-word;
    overflow-wrap: anywhere;
  }

  .hero-subtitle {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-block-end: 2rem;
  }

  .hero-cta-group {
    display: flex;
    justify-content: center;
    gap: 1rem;
  }

  /* Section Header */
  .section-header {
    text-align: start;
    margin-block-end: 2.25rem;
  }

  .section-title {
    font-size: 1.875rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-block-end: 0.5rem;
    word-break: break-word;
    overflow-wrap: anywhere;
  }

  .section-subtitle {
    font-size: 1rem;
    color: var(--text-muted);
  }

  /* Tools Grid */
  .tools-section {
    padding-block: 4rem;
    scroll-margin-top: calc(var(--header-height) + 1.5rem);
    width: 100%;
    box-sizing: border-box;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
    width: 100%;
    box-sizing: border-box;
  }

  .tool-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    transition: border-color 0.15s ease, background-color 0.15s ease;
    box-sizing: border-box;
  }

  .tool-card:hover {
    border-color: var(--border-focus);
    background-color: var(--bg-surface-elevated);
  }

  .tool-card-icon {
    color: var(--text-primary);
  }

  .tool-card-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-block-end: 0.5rem;
    word-break: break-word;
  }

  .tool-card-desc {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .tool-card-action {
    margin-top: auto;
  }

  .tool-link {
    width: 100%;
    justify-content: space-between;
  }

  /* How it works */
  .how-it-works-section {
    padding-block: 4rem;
    background-color: var(--bg-surface);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    width: 100%;
    box-sizing: border-box;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
  }

  .step-card {
    background-color: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .step-num {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--text-muted);
  }

  .step-title {
    font-size: 1.125rem;
    font-weight: 700;
    word-break: break-word;
  }

  .step-desc {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* Features */
  .features-section {
    padding-block: 4rem;
    width: 100%;
    box-sizing: border-box;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
  }

  .feature-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.75rem;
  }

  .feature-title {
    font-size: 1.125rem;
    font-weight: 700;
    margin-block-end: 0.5rem;
    word-break: break-word;
  }

  .feature-desc {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .home-faq-section {
    padding-block-end: 3rem;
  }

  /* ==========================================================================
     MOBILE RESPONSIVENESS (< 640px)
     ========================================================================== */
  @media (max-width: 640px) {
    .hero-section {
      padding-block: 2.75rem 2rem;
    }

    .hero-subtitle {
      font-size: 1rem;
      margin-block-end: 1.5rem;
    }

    .hero-cta-group {
      width: 100%;
    }

    .hero-cta-btn {
      width: 100%;
      padding-inline: 1rem;
    }

    .tools-section,
    .how-it-works-section,
    .features-section {
      padding-block: 2.5rem;
    }

    .section-header {
      margin-block-end: 1.5rem;
    }

    .section-title {
      font-size: 1.5rem;
    }

    .tools-grid,
    .steps-grid,
    .features-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .tool-card {
      padding: 1.5rem 1.25rem;
    }

    .step-card,
    .feature-card {
      padding: 1.25rem;
    }
  }

  @media (max-width: 360px) {
    .tool-card {
      padding: 1.25rem 1rem;
    }
  }
</style>
